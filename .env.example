# Адрес сайта (canonical, ссылки возврата из платёжки)
SITE_URL=http://localhost:4500

# Почта администраторов через запятую (вход по коду из письма). Пусто — arm2730@mail.ru.
# Остальных админов можно добавить в админке
ADMIN_EMAILS=arm2730@mail.ru

# Оплата: ЮKassa. Пусто — включается тестовая платёжная страница (только для разработки)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — передавать чек (54-ФЗ) в ЮKassa
YOOKASSA_RECEIPTS=false
# Код ставки НДС для чека ЮKassa (1 — без НДС)
YOOKASSA_VAT_CODE=1

# Почта (SMTP): коды входа и письма о заказах. Пусто — письма пишутся в лог сервера,
# в разработке и демо код входа показывается на странице. Подойдёт почта Яндекса/Mail.ru для домена,
# Unisender Go, SendPulse и любой SMTP-сервис. 465 — SSL, 587 — STARTTLS.
# Mail.ru: в SMTP_PASS — «пароль для внешних приложений» (Настройки ящика → Безопасность), не обычный пароль
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=arm2730@mail.ru
SMTP_PASS=
SMTP_FROM=PALADA <arm2730@mail.ru>

# Поиск компании по ИНН: DaData. Пусто — тестовые реквизиты для любого корректного ИНН
DADATA_API_KEY=

# true — витрина для показа: код входа на экране, тестовая оплата. НЕ включать на боевом сайте
DEMO_MODE=

# true — заполнить новую базу тестовыми покупателями, заказами и промокодами (только для разработки)
SEED_DEMO=

# Путь к базе SQLite (по умолчанию data/palada.db). Загруженные фото — в папке uploads рядом с базой
DB_PATH=
