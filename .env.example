# Адрес сайта (canonical, ссылки возврата из платёжки)
SITE_URL=http://localhost:4500

# Телефоны администраторов через запятую (вход по СМС, как у покупателей)
ADMIN_PHONES=+79000000000

# Оплата: ЮKassa. Пусто — включается тестовая платёжная страница (только для разработки)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — передавать чек (54-ФЗ) в ЮKassa
YOOKASSA_RECEIPTS=false
# Код ставки НДС для чека ЮKassa (1 — без НДС)
YOOKASSA_VAT_CODE=1

# СМС: sms.ru. Пусто — код пишется в лог сервера и показывается на странице входа (только dev)
SMSRU_API_ID=

# Поиск компании по ИНН: DaData. Пусто — тестовые реквизиты для любого корректного ИНН
DADATA_API_KEY=

# true — публичное демо: код входа на экране, тестовая оплата, демо-данные. НЕ включать на боевом сайте
DEMO_MODE=

# true — заполнить новую боевую базу демо-покупателями и заказами (по умолчанию только в разработке)
SEED_DEMO=

# Путь к базе SQLite (по умолчанию data/palada.db)
DB_PATH=
