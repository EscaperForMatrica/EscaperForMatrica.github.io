---
import Shop from '../layouts/Shop.astro';
import OtpStep from '../components/OtpStep.astro';

const next = Astro.url.searchParams.get('next') || '';
if (Astro.locals.user) return Astro.redirect('/account');
const email = Astro.url.searchParams.get('email') || '';
---
<Shop title="Регистрация" header="compact" tool="account" tab="account" noindex footer={false} fabs={false} mobileHeader={{ kind: 'plain' }}>
  <div class="auth" style="padding-top: 72px; align-items: flex-start; min-height: 1134px;">
    <div class="auth-card" style="width: 520px;" data-form-card>
      <div class="seg"><a href={`/login${next ? `?next=${encodeURIComponent(next)}` : ''}`}>Вход</a><span class="on">Регистрация</span></div>
      <div class="col g8"><h1 class="t-h3" style="font-size: 26px;"><span class="d-only">Создать личный кабинет</span><span class="m-only m-h2">Регистрация</span></h1><p class="sm muted">Заказы, трек-номера и избранное — в одном месте.</p></div>
      <form class="col g20" data-auth-form data-purpose="register" data-next={next} novalidate>
        <div class="pl-field"><label class="pl-field__label" for="r-name">ФИО</label><input class="pl-input" id="r-name" name="name" placeholder="Фамилия Имя Отчество" autocomplete="name" data-req /><span class="pl-field__error" hidden data-err="name"><i class="ic ic-alert ic-16"></i><span></span></span></div>
        <div class="pl-field"><label class="pl-field__label" for="r-email">Email</label><input class="pl-input" id="r-email" name="email" value={email} type="email" placeholder="name@mail.ru" inputmode="email" autocomplete="email" data-req /><span class="pl-field__hint">На неё придёт код подтверждения</span><span class="pl-field__error" hidden data-err="email"><i class="ic ic-alert ic-16"></i><span></span></span></div>
        <div class="pl-field"><label class="pl-field__label" for="r-phone">Номер телефона <i>(необязательно)</i></label><input class="pl-input" id="r-phone" name="phone" type="tel" placeholder="+7 (___) ___-__-__" inputmode="tel" autocomplete="tel" data-phone /><span class="pl-field__hint">Для связи по заказам и доставке</span><span class="pl-field__error" hidden data-err="phone"><i class="ic ic-alert ic-16"></i><span></span></span></div>
        <div class="col g16" style="padding-top: 4px;">
          <div class="col g4">
            <label class="pl-check"><input type="checkbox" name="offer" data-req /><span class="pl-check__box"><i class="ic ic-check ic-16" style="color: #fff;"></i></span><span>Принимаю условия <a href="/legal/offer" target="_blank">оферты</a> <span class="pl-check__req">— обязательно</span></span></label>
            <span class="pl-field__error" style="padding-left: 32px;" hidden data-err="offer"><i class="ic ic-alert ic-16"></i><span></span></span>
          </div>
          <div class="col g4">
            <label class="pl-check"><input type="checkbox" name="pd" data-req /><span class="pl-check__box"><i class="ic ic-check ic-16" style="color: #fff;"></i></span><span>Даю согласие на <a href="/legal/consent" target="_blank">обработку персональных данных</a> <span class="pl-check__req">— обязательно</span></span></label>
            <span class="pl-field__error" style="padding-left: 32px;" hidden data-err="pd"><i class="ic ic-alert ic-16"></i><span></span></span>
          </div>
          <label class="pl-check"><input type="checkbox" name="newsletter" /><span class="pl-check__box"><i class="ic ic-check ic-16" style="color: #fff;"></i></span><span>Хочу получать новости и акции компании</span></label>
        </div>
        <div class="col g12">
          <button class="pl-btn pl-btn--primary pl-btn--block is-disabled" type="submit">Получить код</button>
          <p class="xs muted" style="text-align: center;" data-ready-hint>Заполните поля и отметьте обязательные согласия</p>
        </div>
      </form>
      <p class="sm muted" style="text-align: center;">Уже есть кабинет? <a class="link" href="/login">Войти</a> · Покупаете для компании? <a class="link" href="/b2b/register">Регистрация для опта</a></p>
    </div>
    <OtpStep width={520} />
  </div>
</Shop>
<script>
  import '../scripts/auth';
</script>
