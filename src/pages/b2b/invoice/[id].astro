---
import '../../../styles/tokens.css';
import '../../../styles/components.css';
import '../../../styles/icons.css';
import '../../../styles/screens.css';
import '../../../styles/site.css';
import { getOrder, orderItems, canView } from '../../../lib/orders';
import { db } from '../../../lib/db';
import { shop } from '../../../lib/config';
import { rub, num, dateDots } from '../../../lib/format';

// Счёт на оплату для печати / сохранения в PDF. Банковские реквизиты и НДС — заполнить по данным бухгалтерии.
const o = getOrder(Number(Astro.params.id));
if (!o || o.kind !== 'b2b' || !canView(o, Astro.locals)) return Astro.rewrite('/404');
const items = orderItems(o.id);
const company = o.company_id ? db.get<any>('select * from companies where id = ?', o.company_id) : undefined;
const rows = [...items.map((i) => ({ name: `${i.name}, ${i.variant}`, qty: i.qty, unit: 'шт.', price: i.price, sum: i.price * i.qty })), ...(o.delivery_cost ? [{ name: `Доставка до ПВЗ ${o.delivery_type === 'wb' ? 'Wildberries' : 'Ozon'}`, qty: 1, unit: 'усл.', price: o.delivery_cost, sum: o.delivery_cost }] : [])];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Счёт № {o.id} от {dateDots(o.created_at)} — PALADA</title>
  </head>
  <body>
    <div class="page doc">
      <div class="row between no-print" style="margin-bottom: 32px; gap: 12px; flex-wrap: wrap;">
        <a class="pl-btn pl-btn--text" href="/b2b/account" style="padding-left: 0;"><i class="ic ic-chev-l ic-20"></i>В кабинет компании</a>
        <button class="pl-btn pl-btn--primary pl-btn--sm" type="button" onclick="window.print()"><i class="ic ic-upload ic-18" style="transform: rotate(180deg);"></i>Сохранить в PDF / печать</button>
      </div>
      <div class="row between" style="align-items: flex-start; margin-bottom: 24px;">
        <span class="logo"><img src="/images/logo.png" alt="" width="24" height="21" />PALADA</span>
        <span class="sm muted" style="text-align: right;">{shop.legalName}<br />ИНН {shop.inn} · ОГРН {shop.ogrn}<br />{shop.supportPhone}</span>
      </div>
      <table style="margin-bottom: 24px;">
        <tbody>
          <tr><td style="width: 50%;" colspan="2">Банк получателя: [наименование банка]</td><td>БИК</td><td>[БИК]</td></tr>
          <tr><td colspan="2"></td><td>Сч. №</td><td>[корр. счёт]</td></tr>
          <tr><td>ИНН {shop.inn}</td><td>КПП [КПП]</td><td rowspan="2">Сч. №</td><td rowspan="2">[расчётный счёт]</td></tr>
          <tr><td colspan="2">Получатель: {shop.legalName}</td></tr>
        </tbody>
      </table>
      <h1 class="t-h3" style="font-size: 24px; margin-bottom: 16px;">Счёт на оплату № {o.id} от {dateDots(o.created_at)}</h1>
      <div class="col g4 sm" style="margin-bottom: 20px;">
        <span><span class="muted">Поставщик:</span> {shop.legalName}, ИНН {shop.inn}, [юридический адрес]</span>
        <span><span class="muted">Покупатель:</span> {company?.name || o.name}{company && `, ИНН ${company.inn}`}{company?.kpp && `, КПП ${company.kpp}`}{company?.address && `, ${company.address}`}</span>
        <span><span class="muted">Основание:</span> заказ № {o.id} на сайте {shop.domain}</span>
      </div>
      <table>
        <thead><tr><th>№</th><th>Товар, работа, услуга</th><th class="num">Кол-во</th><th>Ед.</th><th class="num">Цена</th><th class="num">Сумма</th></tr></thead>
        <tbody>
          {rows.map((r, i) => <tr><td>{i + 1}</td><td>{r.name}</td><td class="num">{num(r.qty)}</td><td>{r.unit}</td><td class="num">{num(r.price)},00</td><td class="num">{num(r.sum)},00</td></tr>)}
        </tbody>
      </table>
      <div class="col g4" style="align-items: flex-end; margin-top: 12px;">
        <b>Итого: {num(o.total)},00 ₽</b>
        <span class="sm">[НДС — по данным бухгалтерии]</span>
        <b>Всего к оплате: {rub(o.total)}</b>
      </div>
      <p class="sm" style="margin-top: 16px;">Всего наименований {rows.length}, на сумму {rub(o.total)}. Оплата этого счёта означает согласие с условиями <a class="link" href="/legal/offer-b2b">оферты для юридических лиц и ИП</a>. Товар отгружается после поступления оплаты на расчётный счёт.</p>
      <div class="row g48" style="margin-top: 40px;">
        <span class="sm">Руководитель ______________ [ФИО]</span>
        <span class="sm">Бухгалтер ______________ [ФИО]</span>
      </div>
    </div>
  </body>
</html>
