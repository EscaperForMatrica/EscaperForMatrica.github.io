---
import Admin from '../../../layouts/Admin.astro';
import { db } from '../../../lib/db';
import { hydrate, categories, norm, ensureSearch } from '../../../lib/catalog';
import { imageUrl } from '../../../lib/images';
import { rub } from '../../../lib/format';
import { adminUrl } from '../../../lib/config';

ensureSearch();
const LOW = 10;
const PER = 10;
const sp = Astro.url.searchParams;
const q = (sp.get('q') || '').trim();
const f = sp.get('f') || 'all';
const cat = sp.get('cat') || '';
const page = Math.max(1, Number(sp.get('page')) || 1);
const cats = categories();

const where: string[] = [];
const params: any[] = [];
if (q) {
  where.push('(p.search like ? or p.sku like ?)');
  params.push(`%${norm(q)}%`, `%${q}%`);
}
if (cat) {
  where.push('c.slug = ?');
  params.push(cat);
}
const filters: Record<string, string> = { site: 'p.visible = 1', hidden: 'p.visible = 0', low: `p.visible = 1 and p.stock < ${LOW}` };
const base = where.length ? `where ${where.join(' and ')}` : '';
const withF = (k: string) => [where.join(' and '), filters[k]].filter(Boolean).join(' and ');
const countOf = (k: string) => db.value<number>(`select count(*) from products p left join categories c on c.id = p.category_id ${withF(k) ? 'where ' + withF(k) : ''}`, ...params) || 0;
const counts = { site: countOf('site'), hidden: countOf('hidden'), low: countOf('low') };
const cond = filters[f] ? withF(f) : where.join(' and ');
const total = db.value<number>(`select count(*) from products p left join categories c on c.id = p.category_id ${cond ? 'where ' + cond : ''}`, ...params) || 0;
const rows = db
  .all(`select p.*, c.name as category_name, c.slug as category_slug from products p left join categories c on c.id = p.category_id ${cond ? 'where ' + cond : ''} order by p.sort, p.id limit ? offset ?`, ...params, PER, (page - 1) * PER)
  .map(hydrate);
const allCount = db.value<number>(`select count(*) from products p left join categories c on c.id = p.category_id ${base}`, ...params) || 0;
const link = (patch: Record<string, string | null>) => {
  const u = new URLSearchParams(sp);
  for (const [k, v] of Object.entries(patch)) v ? u.set(k, v) : u.delete(k);
  if (!('page' in patch)) u.delete('page');
  const s = u.toString();
  return adminUrl('/products') + (s ? `?${s}` : '');
};
const from = total ? (page - 1) * PER + 1 : 0;
const to = Math.min(total, page * PER);
---
<Admin title="Товары" active="products">
  <div class="adm-top"><h1 class="t-h3" style="font-size: 26px;">Товары</h1><span class="muted">{allCount}</span><span class="grow"></span><a class="pl-btn pl-btn--primary pl-btn--sm" href={adminUrl('/products/new')}><i class="ic ic-plus ic-18"></i>Добавить товар</a></div>
  <div class="adm-top">
    <form action={adminUrl('/products')} method="get" style="position: relative; width: 320px; max-width: 100%;" role="search">
      {f !== 'all' && <input type="hidden" name="f" value={f} />}{cat && <input type="hidden" name="cat" value={cat} />}
      <i class="ic ic-search ic-18 muted" style="position: absolute; left: 12px; top: 11px;"></i><input class="pl-input" name="q" value={q} style="height: 40px; padding-left: 38px; font-size: 14px;" placeholder="Название или артикул" aria-label="Поиск товара" />
    </form>
    <div class="chips">
      <a class={`chip ${f === 'all' ? 'on' : ''}`} href={link({ f: null })}>Все</a>
      <a class={`chip ${f === 'site' ? 'on' : ''}`} href={link({ f: 'site' })}>На сайте <span class="n">{counts.site}</span></a>
      <a class={`chip ${f === 'hidden' ? 'on' : ''}`} href={link({ f: 'hidden' })}>Скрыты <span class="n">{counts.hidden}</span></a>
      <a class={`chip ${f === 'low' ? 'on' : ''}`} href={link({ f: 'low' })}>Заканчиваются <span class="n">{counts.low}</span></a>
    </div>
    <span class="grow"></span>
    <label class="select"><span>Категория: {cats.find((c) => c.slug === cat)?.name.toLowerCase() || 'все'}</span><i class="ic ic-chev-d ic-18"></i>
      <select name="cat" data-nav data-prefix="Категория: " aria-label="Категория"><option value="">все</option>{cats.map((c) => <option value={c.slug} selected={c.slug === cat}>{c.name.toLowerCase()}</option>)}</select>
    </label>
  </div>
  <div class="tbl-box">
    <table class="tbl" data-products>
      <thead><tr><th style="width: 40px;"><label class="pl-check" aria-label="Выбрать все"><input type="checkbox" data-all /><span class="pl-check__box"><i class="ic ic-check ic-16" style="color: #fff;"></i></span></label></th><th>Товар</th><th>Категория</th><th>Артикул</th><th class="num">Цена</th><th class="num">Старая цена</th><th class="num">Остаток</th><th>На сайте</th><th></th></tr></thead>
      <tbody>
        {rows.map((p) => (
          <tr data-row={p.id}>
            <td><label class="pl-check" aria-label={`Выбрать ${p.name}`}><input type="checkbox" data-pick={p.id} /><span class="pl-check__box"><i class="ic ic-check ic-16" style="color: #fff;"></i></span></label></td>
            <td class="nm"><a class="row g12" href={adminUrl(`/products/${p.id}`)}><span class="tb-img"><img src={imageUrl(p.images[0])} alt="" width="44" height="44" /></span><span class="col"><b style="font-weight: 600;">{p.name}</b><span class="xs muted">{p.variant}</span></span></a></td>
            <td class="nw">{p.category_name || '—'}</td>
            <td class={p.sku ? '' : 'muted'}>{p.sku || '—'}</td>
            <td class={`num ${p.price === null ? 'muted' : ''}`}>{p.price === null ? 'не задана' : rub(p.price)}</td>
            <td class="num muted">{p.old_price ? rub(p.old_price) : '—'}</td>
            <td class="num">{p.stock === 0 ? <span class="muted">0</span> : p.stock < LOW ? <span class="pl-badge pl-badge--discount" style="height: 22px;">{p.stock}</span> : p.stock}</td>
            <td><button class={`pl-toggle ${p.visible ? 'is-on' : ''}`} type="button" role="switch" aria-checked={p.visible ? 'true' : 'false'} aria-label="Показывать на сайте" data-visible={p.id}><span class="pl-toggle__track"></span></button></td>
            <td><span class="row g4"><a class="act" href={adminUrl(`/products/${p.id}`)} aria-label="Редактировать"><i class="ic ic-edit ic-18"></i></a><button class="act" type="button" aria-label="Удалить" data-del={p.id} data-name={p.name}><i class="ic ic-trash ic-18"></i></button></span></td>
          </tr>
        ))}
        {!rows.length && <tr><td colspan="9" class="muted" style="padding: 32px 16px; text-align: center;">Товаров не найдено</td></tr>}
      </tbody>
    </table>
  </div>
  <div class="row between sm muted g16" style="flex-wrap: wrap;">
    <span data-bulk hidden>Выбрано: <b data-bulk-n>0</b> · <button class="link" type="button" data-bulk-hide>Скрыть с сайта</button> · <button class="link" type="button" data-bulk-show>Показать</button> · <button class="link-warm" type="button" data-bulk-del>Удалить</button></span>
    <span data-bulk-empty>Отметьте товары, чтобы скрыть или удалить несколько сразу</span>
    <span class="row g8">{from}–{to} из {total}
      {page > 1 ? <a class="act" href={link({ page: String(page - 1) })} aria-label="Назад"><i class="ic ic-chev-l ic-18"></i></a> : <span class="act" style="opacity: .35;"><i class="ic ic-chev-l ic-18"></i></span>}
      {to < total ? <a class="act" href={link({ page: String(page + 1) })} aria-label="Вперёд"><i class="ic ic-chev-r ic-18"></i></a> : <span class="act" style="opacity: .35;"><i class="ic ic-chev-r ic-18"></i></span>}
    </span>
  </div>
</Admin>
<script>
  import { api, toast } from '../../../scripts/app';
  const picks = () => Array.from(document.querySelectorAll<HTMLInputElement>('[data-pick]:checked')).map((i) => Number(i.dataset.pick));
  const sync = () => {
    const ids = picks();
    document.querySelector<HTMLElement>('[data-bulk]')!.hidden = !ids.length;
    document.querySelector<HTMLElement>('[data-bulk-empty]')!.hidden = ids.length > 0;
    document.querySelector('[data-bulk-n]')!.textContent = String(ids.length);
    document.querySelectorAll<HTMLInputElement>('[data-pick]').forEach((i) => i.closest('tr')!.classList.toggle('sel', i.checked));
  };
  document.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.matches('[data-all]')) document.querySelectorAll<HTMLInputElement>('[data-pick]').forEach((i) => {
      i.checked = t.checked;
      i.closest('.pl-check')!.classList.toggle('is-checked', t.checked);
    });
    if (t.matches('[data-all], [data-pick]')) sync();
  });
  document.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const tg = t.closest<HTMLButtonElement>('[data-visible]');
    if (tg) {
      const on = !tg.classList.contains('is-on');
      tg.classList.toggle('is-on', on);
      tg.setAttribute('aria-checked', String(on));
      const r = await api('/api/admin/products', { action: 'visible', ids: [Number(tg.dataset.visible)], on });
      if (!r.ok) toast(r.error, 'error');
      return;
    }
    const del = t.closest<HTMLButtonElement>('[data-del]');
    if (del) {
      if (!confirm(`Удалить «${del.dataset.name}»? Это нельзя отменить.`)) return;
      const r = await api('/api/admin/products', { action: 'delete', ids: [Number(del.dataset.del)] });
      return r.ok ? location.reload() : toast(r.error, 'error');
    }
    if (t.closest('[data-bulk-hide]') || t.closest('[data-bulk-show]')) {
      const r = await api('/api/admin/products', { action: 'visible', ids: picks(), on: Boolean(t.closest('[data-bulk-show]')) });
      return r.ok ? location.reload() : toast(r.error, 'error');
    }
    if (t.closest('[data-bulk-del]')) {
      if (!confirm(`Удалить выбранные товары (${picks().length})? Это нельзя отменить.`)) return;
      const r = await api('/api/admin/products', { action: 'delete', ids: picks() });
      return r.ok ? location.reload() : toast(r.error, 'error');
    }
  });
</script>
