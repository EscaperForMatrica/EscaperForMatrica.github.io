---
import { getPvz, deliveryCost, deliveryEta, deliveryDaysLabel, mapUrl, refreshPvzIfStale, type DeliveryType, type Pvz } from '../lib/delivery';
import { rub } from '../lib/format';

interface Props {
  type?: DeliveryType;
  /** Выбранный ПВЗ Wildberries (id из справочника WB). */
  pvzId?: string;
  /** Адрес пункта Ozon, который покупатель вписал в прошлый раз. */
  ozonAddress?: string;
  /** Оптовый заказ: доставка считается по числу коробок. */
  boxes?: number;
  /** Если ПВЗ уже выбран — показываем его строкой с кнопкой «Изменить» (макет оптового оформления). */
  collapsible?: boolean;
}
const { type = 'ozon', pvzId = '', ozonAddress = '', boxes = 0, collapsible = false } = Astro.props;
refreshPvzIfStale();
const selected = pvzId ? getPvz(pvzId) : undefined;
const cost = { ozon: deliveryCost('ozon', boxes), wb: deliveryCost('wb', boxes) };
const eta = { ozon: deliveryEta('ozon'), wb: deliveryEta('wb') };
const days = { ozon: deliveryDaysLabel('ozon'), wb: deliveryDaysLabel('wb') };
const boxesNote = boxes ? `${boxes} ${boxes === 1 ? 'коробка' : boxes < 5 ? 'коробки' : 'коробок'} — крупное отправление. Если пункт не примет такие габариты, менеджер свяжется и предложит вариант.` : '';
const point = (p: Pvz, on: boolean) => ({ p, on, map: mapUrl(p) });
---
<div class="col" data-delivery data-boxes={boxes} data-conf={JSON.stringify({ cost, eta })}>
  <div class="grid2 delivery-opts" style="margin-bottom: 24px;" role="radiogroup" aria-label="Способ доставки">
    <label class={`pl-option ${type === 'ozon' ? 'is-selected' : ''}`}>
      <input type="radio" name="delivery_type" value="ozon" checked={type === 'ozon'} />
      <span class="pl-radio"></span>
      <span class="col grow"><b style="font-weight: 600;"><span class="d-only">Пункт выдачи Ozon</span><span class="m-only">ПВЗ Ozon</span></b><span class="sm muted">По адресу пункта · {rub(cost.ozon)} · {days.ozon}</span></span>
    </label>
    <label class={`pl-option ${type === 'wb' ? 'is-selected' : ''}`}>
      <input type="radio" name="delivery_type" value="wb" checked={type === 'wb'} />
      <span class="pl-radio"></span>
      <span class="col grow"><b style="font-weight: 600;"><span class="d-only">Пункт выдачи Wildberries</span><span class="m-only">ПВЗ Wildberries</span></b><span class="sm muted">Выбор из списка · {rub(cost.wb)} · {days.wb}</span></span>
    </label>
  </div>

  <div data-panel="ozon" hidden={type !== 'ozon'}>
    <div class="pl-field">
      <label class="pl-field__label" for="ozon_address">Адрес пункта выдачи Ozon</label>
      <textarea class="pl-input" id="ozon_address" name="ozon_address" style="min-height: 80px;" placeholder="г. Ростов-на-Дону, ул. Большая Садовая, 47">{ozonAddress}</textarea>
      <span class="pl-field__hint">Скопируйте адрес удобного пункта из приложения Ozon или со страницы ozon.ru/geo</span>
      <span class="pl-field__error" hidden data-err="pvz"><i class="ic ic-alert ic-16"></i>Укажите адрес пункта выдачи с городом и улицей</span>
    </div>
    <div class="pl-note" style="margin-top: 16px;"><i class="ic ic-info"></i><span>{boxesNote || `Отправку оформит менеджер, трек-номер появится в личном кабинете. Заказ хранится в пункте 7 дней — возьмите паспорт или покажите QR-код из приложения Ozon. Доставка — ${rub(cost.ozon)}, ${days.ozon}.`}</span></div>
  </div>

  <div data-panel="wb" hidden={type !== 'wb'}>
    {collapsible && selected && (
      <div class="pvz on" data-summary style="cursor: default;"><i class="ic ic-store ic-20" style="color: var(--accent-ink);"></i><div class="col g4 grow"><b style="font-weight: 600;">{selected.address}</b><span class="muted">{selected.hours} · {rub(cost.wb)} · {eta.wb}</span></div><button class="pl-btn pl-btn--secondary pl-btn--sm" type="button" style="background: var(--surface);" data-expand>Изменить</button></div>
    )}
    <div data-full hidden={Boolean(collapsible && selected)}>
      <div class="pl-field" style="margin-bottom: 12px;">
        <label class="pl-field__label" for="wb_q">Город и улица</label>
        <div class="city-field">
          <i class="ic ic-search ic-20 muted" style="position: absolute; left: 14px; top: 14px;"></i>
          <input class="pl-input" id="wb_q" type="search" style="padding-left: 44px;" placeholder="Например: Ростов-на-Дону Пушкинская" autocomplete="off" aria-controls="wb-list" data-wb-q />
        </div>
        <span class="pl-field__hint">Все пункты выдачи Wildberries — справочник WB обновляется каждый день</span>
      </div>
      <div class="pvz-list" id="wb-list" data-list role="listbox" aria-label="Пункты выдачи Wildberries">
        {selected
          ? [point(selected, true)].map(({ p, map }) => (
              <div class="pvz on" role="option" tabindex="0" aria-selected="true" data-pvz={p.id} data-address={p.address}>
                <i class="ic ic-store ic-20" style="color: var(--accent-ink);"></i>
                <div class="col g4 grow"><b style="font-weight: 600;">{p.address}</b><span class="muted">{p.hours}</span>
                  <span class="row between"><span class="save" style="font-weight: 600;">{rub(cost.wb)} · {eta.wb}</span><span class="row g12">{map && <a class="xs link" href={map} target="_blank" rel="noopener">На карте</a>}<span class="xs" style="color: var(--accent-ink);">Выбран</span></span></span>
                </div>
              </div>
            ))
          : <p class="sm muted" style="padding: 8px 4px;" data-hint>Введите город и улицу — покажем пункты выдачи Wildberries.</p>}
      </div>
    </div>
    <input type="hidden" name="pvz_id" value={selected?.id || ''} data-pvz-input />
    <span class="pl-field__error" style="margin-top: 8px;" hidden data-err="wb"><i class="ic ic-alert ic-16"></i>Выберите пункт выдачи из списка</span>
    <div class="pl-note" style="margin-top: 16px;"><i class="ic ic-info"></i><span>{boxesNote || `Отправку оформит менеджер, трек-номер появится в личном кабинете. Доставка — ${rub(cost.wb)}, ${days.wb}.`}</span></div>
  </div>
</div>

<script>
  import { rubJs } from '../scripts/fmt';

  type Pt = { id: string; address: string; hours: string; map: string };
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  document.querySelectorAll<HTMLElement>('[data-delivery]').forEach((root) => {
    const conf = JSON.parse(root.dataset.conf || '{}');
    const q = root.querySelector<HTMLInputElement>('[data-wb-q]')!;
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const hidden = root.querySelector<HTMLInputElement>('[data-pvz-input]')!;
    const ozon = root.querySelector<HTMLTextAreaElement>('#ozon_address')!;

    const state = () => {
      const type = (root.querySelector<HTMLInputElement>('input[name="delivery_type"]:checked')?.value || 'ozon') as 'ozon' | 'wb';
      if (type === 'ozon') {
        const addr = ozon.value.trim();
        return { type, cost: conf.cost.ozon, label: 'ПВЗ Ozon', address: addr, valid: addr.length >= 10, eta: conf.eta.ozon };
      }
      const on = list.querySelector<HTMLElement>('.pvz.on');
      return on && hidden.value
        ? { type, cost: conf.cost.wb, label: 'ПВЗ WB', address: on.dataset.address, valid: true, eta: conf.eta.wb }
        : { type, cost: conf.cost.wb, label: 'ПВЗ WB', address: '', valid: false, eta: conf.eta.wb };
    };
    const emit = () => root.dispatchEvent(new CustomEvent('delivery-change', { bubbles: true, detail: state() }));

    const row = (p: Pt, on: boolean) => `<div class="pvz${on ? ' on' : ''}" role="option" tabindex="0" aria-selected="${on}" data-pvz="${esc(p.id)}" data-address="${esc(p.address)}">
      <i class="ic ic-store ic-20${on ? '' : ' muted'}"${on ? ' style="color: var(--accent-ink);"' : ''}></i>
      <div class="col g4 grow"><b style="font-weight: 600;">${esc(p.address)}</b><span class="muted">${esc(p.hours)}</span>
        <span class="row between"><span${on ? ' class="save" style="font-weight: 600;"' : ''}>${rubJs(conf.cost.wb)} · ${conf.eta.wb}</span><span class="row g12">${p.map ? `<a class="xs link" href="${esc(p.map)}" target="_blank" rel="noopener">На карте</a>` : ''}${on ? '<span class="xs" style="color: var(--accent-ink);">Выбран</span>' : ''}</span></span>
      </div></div>`;

    let points: Pt[] = [];
    const render = (note = '') => {
      list.innerHTML = points.map((p) => row(p, p.id === hidden.value)).join('') + (note ? `<p class="sm muted" style="padding: 8px 4px;">${note}</p>` : '');
    };

    const select = (el: HTMLElement) => {
      hidden.value = el.dataset.pvz!;
      const p = points.find((x) => x.id === hidden.value);
      if (p) render();
      else {
        list.querySelectorAll<HTMLElement>('.pvz').forEach((b) => b.classList.toggle('on', b === el));
      }
      root.querySelector<HTMLElement>('[data-err="wb"]')!.hidden = true;
      emit();
    };

    let timer = 0;
    let seq = 0;
    const search = async () => {
      const text = q.value.trim();
      if (text.length < 3) return;
      const my = ++seq;
      const r = await fetch(`/api/delivery?q=${encodeURIComponent(text)}`).then((x) => x.json()).catch(() => null);
      if (my !== seq) return;
      if (!r) return render('Не удалось загрузить пункты. Попробуйте ещё раз.');
      if (!r.ready) {
        points = [];
        render('Загружаем справочник пунктов Wildberries…');
        timer = window.setTimeout(search, 2500);
        return;
      }
      points = r.points;
      const more = r.total > points.length ? `Показаны ${points.length} из ${r.total} — уточните улицу.` : '';
      render(points.length ? more : 'Пунктов не нашли. Проверьте написание или укажите только город и улицу.');
    };
    q.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(search, 300);
    });
    q.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        clearTimeout(timer);
        search();
      }
    });

    root.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t.closest('a')) return;
      const item = t.closest<HTMLElement>('[data-pvz]');
      if (item && list.contains(item)) return select(item);
      if (t.closest('[data-expand]')) {
        root.querySelector<HTMLElement>('[data-summary]')!.hidden = true;
        root.querySelector<HTMLElement>('[data-full]')!.hidden = false;
        q.focus();
      }
    });
    list.addEventListener('keydown', (e) => {
      const item = (e.target as HTMLElement).closest<HTMLElement>('[data-pvz]');
      if (item && (e.key === 'Enter' || e.key === ' ')) {
        e.preventDefault();
        select(item);
      }
    });

    root.addEventListener('change', (e) => {
      const r = e.target as HTMLInputElement;
      if (r.name !== 'delivery_type') return;
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== r.value));
      emit();
    });
    ozon.addEventListener('input', () => {
      root.querySelector<HTMLElement>('[data-err="pvz"]')!.hidden = true;
      emit();
    });

    (root as any).deliveryState = state;
    queueMicrotask(emit);
  });
</script>

<style is:global>
  @media (max-width: 767px) {
    .delivery-opts { grid-template-columns: 1fr !important; gap: 8px !important; margin-bottom: 16px !important; }
  }
</style>
