---
// Шаг «Введите код» (общий для входа и регистраций).
interface Props {
  width?: number;
}
const { width } = Astro.props;
---
<div class="auth-card" data-otp-step hidden style={width ? `width: ${width}px;` : undefined}>
  <button class="pl-btn pl-btn--text" type="button" style="align-self: flex-start; padding-left: 0;" data-otp-back><i class="ic ic-chev-l ic-20"></i>Изменить номер</button>
  <div class="col g8"><h2 class="t-h3" style="font-size: 26px;">Введите код</h2><p class="sm muted">Отправили СМС на <span data-otp-phone></span></p></div>
  <div class="dev-note" hidden data-otp-dev><i class="ic ic-info ic-18"></i><span>Тестовый режим без СМС: код <b data-otp-dev-code></b></span></div>
  <form class="col g8" data-otp-form novalidate>
    <div class="otp spread" role="group" aria-label="Код из СМС">
      <input inputmode="numeric" autocomplete="one-time-code" maxlength="4" aria-label="Цифра 1" data-otp />
      <input inputmode="numeric" maxlength="1" aria-label="Цифра 2" data-otp />
      <input inputmode="numeric" maxlength="1" aria-label="Цифра 3" data-otp />
      <input inputmode="numeric" maxlength="1" aria-label="Цифра 4" data-otp />
    </div>
    <span class="pl-field__error" hidden data-otp-error><i class="ic ic-alert ic-16"></i><span></span></span>
  </form>
  <span class="row g8 sm muted" data-otp-timer><i class="ic ic-clock ic-18"></i>Отправить код повторно через <span data-otp-left>1:00</span></span>
  <button class="pl-btn pl-btn--text" type="button" style="align-self: flex-start; padding-left: 0;" hidden data-otp-resend>Отправить код ещё раз</button>
  <button class="pl-btn pl-btn--primary pl-btn--block is-disabled" type="button" data-otp-submit>Войти</button>
</div>

<style is:global>
  .otp input { width: 56px; height: 64px; border: 1px solid var(--line); border-radius: var(--radius-md); text-align: center; font: 600 28px/1 var(--font-sans); color: var(--ink); background: var(--surface); outline: none; transition: border-color .2s, box-shadow .2s; padding: 0; }
  .otp input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-tint); }
  .otp.is-error input { border-color: var(--error); }
  @media (min-width: 768px) { .otp.spread { justify-content: flex-start; } }
</style>
